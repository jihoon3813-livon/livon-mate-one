# =========================================================================
# 리본메이트 원 (Livon Mate One) - 환경변수 가이드 (.env.example)
# Vercel Project Settings > Environment Variables 에 등록하세요.
# =========================================================================

# 1. Convex Cloud 운영 데이터베이스 URL
CONVEX_URL=https://gallant-weasel-360.convex.cloud

# 2. 카카오 로컬 REST API Key (전국 병원 지능형 실시간 검색용)
KAKAO_REST_KEY=KakaoAK your_kakao_rest_key_here

# 3. (선택) Convex 배포 시 사용되는 배포 타겟 식별자
# CONVEX_DEPLOYMENT=gallant-weasel-360

# 4. 팩스 연동 설정 (알리고 / 팝빌 / 기본 발신번호)
# 미입력 시 스마트 샌드박스 시뮬레이터(모의 발송 모드)로 자동 동작합니다.
FAX_SENDER_NUMBER=02-556-9114
# ALIGO_API_KEY=your_aligo_api_key_here
# ALIGO_USER_ID=your_aligo_user_id_here

# 5. 케어포트 (CarePort) API 계정 (서버측 전용)
CAREPORT_ID=your_careport_id
CAREPORT_PW=your_careport_password

# 6. GoodARS CTI 연동 설정 (서버측 전용)
CTI_BASE_URL=https://crm.goodars.co.kr
CTI_ID=your_cti_id
CTI_PASS=your_cti_password
CTI_CALLER_ID=16007835

# 7. 삼성화재 엑셀 복호화 암호 (월별/기본값)
SAMSUNG_EXCEL_PASSWORD=202609
