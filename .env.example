# =========================================================================
# 리본메이트 원 (Livon Mate One) - 환경변수 가이드 (.env.example)
# Vercel Project Settings > Environment Variables 에 등록하세요.
# =========================================================================

# 1. Convex Cloud 운영 데이터베이스 URL
CONVEX_URL=https://gallant-weasel-360.convex.cloud

# 2. 카카오 로컬 REST API Key (전국 병원 지능형 실시간 검색용)
KAKAO_REST_KEY=KakaoAK 6d1fa1d735dbf6e1e8beb4ed7de2e3b4

# 3. (선택) Convex 배포 시 사용되는 배포 타겟 식별자
# CONVEX_DEPLOYMENT=gallant-weasel-360
