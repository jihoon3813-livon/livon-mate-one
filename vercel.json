{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{*.json,care-report-2page-pdf.js,pdf-helper.js,pdf-lib.min.js}"
    }
  },
  "rewrites": [
    {
      "source": "/careport-embed",
      "destination": "https://careport.livon.care/"
    },
    {
      "source": "/careport-embed/:path*",
      "destination": "https://careport.livon.care/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "https://careport.livon.care/js/:path*"
    },
    {
      "source": "/css/:path*",
      "destination": "https://careport.livon.care/css/:path*"
    },
    {
      "source": "/img/:path*",
      "destination": "https://careport.livon.care/img/:path*"
    },
    {
      "source": "/fonts/:path*",
      "destination": "https://careport.livon.care/fonts/:path*"
    },
    {
      "source": "/audio/stream/:encoded.mp3",
      "destination": "/api/carecall/turn-audio?encoded=:encoded"
    },
    {
      "source": "/care-diary",
      "destination": "/mobile-care-diary.html"
    },
    {
      "source": "/d/:token",
      "destination": "/mobile-care-diary.html"
    },
    {
      "source": "/call-report-view",
      "destination": "/call-report-view.html"
    },
    {
      "source": "/report",
      "destination": "/mobile-care-diary.html"
    },
    {
      "source": "/mate/survey",
      "destination": "/mate-survey.html"
    },
    {
      "source": "/mate-survey",
      "destination": "/mate-survey.html"
    },
    {
      "source": "/survey",
      "destination": "/survey.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
