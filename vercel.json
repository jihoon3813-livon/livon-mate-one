{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/search-hospital",
      "dest": "/api/search-hospital.js"
    },
    {
      "src": "/api/fax/send",
      "dest": "/api/fax/send.js"
    },
    {
      "src": "/api/fax/status",
      "dest": "/api/fax/status.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
