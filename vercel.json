{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30,
      "includeFiles": "*.json"
    }
  },
  "routes": [
    {
      "src": "/api/search-hospital(\\?.*)?",
      "dest": "/api/search-hospital.js$1"
    },
    {
      "src": "/api/fax/send(\\?.*)?",
      "dest": "/api/fax/send.js$1"
    },
    {
      "src": "/api/samsung-drive/status(\\?.*)?",
      "dest": "/api/samsung-drive/status.js$1"
    },
    {
      "src": "/api/samsung-drive/sync(\\?.*)?",
      "dest": "/api/samsung-drive/sync.js$1"
    },
    {
      "src": "/api/fax/status(\\?.*)?",
      "dest": "/api/fax/status.js$1"
    },
    {
      "src": "/api/cti/call(\\?.*)?",
      "dest": "/api/cti/call.js$1"
    },
    {
      "src": "/api/cti/config(\\?.*)?",
      "dest": "/api/cti/config.js$1"
    },
    {
      "src": "/api/cti/logs(\\?.*)?",
      "dest": "/api/cti/logs.js$1"
    },
    {
      "src": "/api/samsung/call-report/data(\\?.*)?",
      "dest": "/api/samsung/call-report/data.js$1"
    },
    {
      "src": "/api/samsung/call-report/sync-cti(\\?.*)?",
      "dest": "/api/samsung/call-report/sync-cti.js$1"
    },
    {
      "src": "/api/samsung/call-report/pdf(\\?.*)?",
      "dest": "/api/samsung/call-report/pdf.js$1"
    },
    {
      "src": "/api/shorten-url(\\?.*)?",
      "dest": "/api/shorten-url.js$1"
    },
    {
      "src": "/(call_report_.*\\.json|samsung_call_report\\.json|call_annotations\\.json)(\\?.*)?",
      "dest": "/$1"
    },
    {
      "src": "/(.*)(_config|phone_map|package\\.json|package-lock\\.json|credentials|secret|\\.env)(.*)",
      "status": 403
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
